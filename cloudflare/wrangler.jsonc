{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sctranslatekit-updates",
  "account_id": "faa2b62743f9b25377c56a98ec6da7e0",
  "main": "./worker.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "pulsar.42kit.com",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPDATES",
      "bucket_name": "sctranslatekit-updates"
    }
  ]
}
